{
  "name": "oneshot-agent",
  "version": "0.3.0",
  "description": "Stops AI coding agents from writing retired models and last year's versions. Live facts for agents plus a check for every pull request: retired AI models, end-of-life runtimes, outdated GitHub Actions and packages.",
  "type": "module",
  "bin": {
    "oneshot-agent": "bin/oneshot.js"
  },
  "exports": {
    ".": "./src/runner.js",
    "./check": "./src/check-helpers.js",
    "./report": "./src/report.js"
  },
  "files": [
    "action.yml",
    "bin",
    "data",
    "src",
    "tasks"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify-tasks": "node bin/oneshot.js verify-tasks",
    "demo": "node bin/oneshot.js run tasks --agent claude --model sonnet --trials 2 --out results/demo && node bin/oneshot.js report results --out site"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent-experience",
    "ai-agents",
    "anthropic",
    "benchmark",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "dependencies",
    "developer-experience",
    "docker",
    "github-action",
    "github-actions",
    "mcp",
    "model-deprecation",
    "openai",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borossdaniel/OneShot.git"
  },
  "homepage": "https://oneshotagent.dev"
}
